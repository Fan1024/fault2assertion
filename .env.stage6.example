# Fault2Assertion Stage-6 OpenAI API configuration template
#
# Do not place a real API key in this tracked file.
#
# Copy this template to:
#
#   ~/.config/fault2assertion/openai.env
#
# Then replace the placeholder in that private local file.

OPENAI_API_KEY="REPLACE_WITH_REAL_OPENAI_API_KEY"

# Low-cost model used only for the initial connectivity smoke.
# This can be changed locally without modifying the repository.
OPENAI_MODEL="gpt-5.6-luna"
